{
    "$schema": "./node_modules/@pterodactyl/sdk/manifest.schema.json",
    "id": "mcp",
    "name": "MCP",
    "version": "1.1.0",
    "requires": {
        "panel": "^2.0.0-dev",
        "sdk": "^2.0.0-beta.6",
        "php": "^8.3"
    },
    "description": "Let AI assistants like Claude, ChatGPT and Gemini manage your servers over the Model Context Protocol.",
    "author": "Izuna Seikatsu",
    "provider": "PterodactylMcp\\McpProvider",
    "ui": {
        "entry": "dist/client.js",
        "mode": "native",
        "prefix": "mcp",
        "screens": [
            {
                "id": "mcp",
                "area": "account",
                "path": "mcp",
                "nav": {
                    "label": "AI Assistants",
                    "icon": "bot"
                }
            }
        ]
    },
    "icon": "bot"
}
